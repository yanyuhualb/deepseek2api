PORT=3000
DEBUG=true
APP_ADMIN_USERNAME=
APP_ADMIN_PASSWORD=

# 生产部署推荐配置
# NODE_ENV=production
# SECRET_ENCRYPTION_KEY=
# ALLOWED_ORIGINS=https://your-domain.com

# 可选安全配置
# DEBUG_SANITIZE=true
# POW_WASM_SHA256=

# 可选速率与超时
# LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
# LOGIN_RATE_LIMIT_WINDOW_MS=60000
# LOGIN_RATE_LIMIT_BLOCK_MS=900000
# UPSTREAM_REQUEST_TIMEOUT_MS=30000
# UPSTREAM_STREAM_TIMEOUT_MS=300000

# 上游代理（绕过 DeepSeek 风控 / 区域限制）
# 优先级: UPSTREAM_PROXY > HTTPS_PROXY > HTTP_PROXY > ALL_PROXY
# 支持 http://、https://、socks5://、socks5h://
# HTTP/HTTPS 代理需要: npm install undici
# SOCKS 代理需要: npm install undici socks-proxy-agent
# UPSTREAM_PROXY=http://127.0.0.1:7890
# UPSTREAM_PROXY=socks5h://127.0.0.1:40000

# 函数调用（Function Calling）引擎 — 融合自 ToolForge
# 注入协议：XYML（默认，更稳健，CDATA 包裹字符串避免转义问题）/ QNML
# FC_PROTOCOL=XYML
# FC 模式：auto（有 tools 时走提示词注入）/ prefer_native / force_prompt
# FC_MODE=auto
# 解析时剥离 <think>...</think> 思维块
# FC_STRIP_THINK_TAGS=true
# 工具名混淆（针对拒绝已知工具名的模型，把 Read/Bash 等映射为 fs_open_file/shell_run）
# FC_OBFUSCATE_TOOL_NAMES=false
# 注入 CLI 工具画像与 few-shot 示例（Claude Code / OpenCode / Hermes 等自动识别）
# FC_ENABLE_CLI_PROFILES=true
# 解析失败时自动重试（追加纠正提示再请求一次上游）
# FC_ERROR_RETRY=true
# FC_ERROR_RETRY_MAX=1
# 未知工具名处理：keep（保留交给模糊别名解析）/ drop（丢弃）/ error
# FC_UNKNOWN_TOOL=keep
# 缺失必填参数处理：keep / drop / error
# FC_MISSING_REQUIRED=keep
# 提示词风格：standard / minimal
# FC_PROMPT_STYLE=standard

